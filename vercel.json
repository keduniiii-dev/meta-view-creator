{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "crm.twinblueprint.com" }],
      "destination": "/crm/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
